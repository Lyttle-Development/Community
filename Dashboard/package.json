{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "start": "npm run build && next start -p 3000",
    "dev:start": "npx rimraf ./.next && next dev -p 8080",
    "dev:only": "next dev -p 8080",
    "deploy": "npm run build",
    "docker:setup": "npm run build",
    "docker:build": "docker build -t community-v3-dashboard .",
    "update": "npm update --save && npx npm-check-updates -u && npm install"
  },
  "volta": {
    "node": "24.15.0"
  },
  "engines": {
    "node": "24.15.0"
  },
  "dependencies": {
    "@apollo/client": "^4.1.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "diff": "^9.0.0",
    "discord.js": "^14.26.4",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.4",
    "gsap": "^3.15.0",
    "next": "^16.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-transition-group": "^4.4.5",
    "remark-gfm": "^4.0.1",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/react-transition-group": "^4.4.12"
  }
}
